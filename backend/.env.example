# ── AGRIFLOW-AI Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Database
# Host tools (Alembic, uvicorn on Windows): localhost + published Podman port.
# Compose/Podman services override to db:5432 via docker-compose.yml environment.
POSTGRES_HOST=localhost
POSTGRES_PORT=25432
POSTGRES_DB=agriflow
POSTGRES_USER=agriflow
POSTGRES_PASSWORD=changeme

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
# Platform JWT (Phase 15 slice 5). Set AUTH_REQUIRED=true in staging/production.
AUTH_REQUIRED=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Bootstrap admin after migration n8o9p0q1r2s3: admin@agriflow.local / changeme-admin

# CORS (comma-separated origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Domain events (Phase 14)
EVENTS_ENABLED=true
REDPANDA_ENABLED=false
REDPANDA_BROKERS=localhost:19092
REDPANDA_CLIENT_ID=agriflow-outbox-relay
REDPANDA_CONSUMER_GROUP_ID=agriflow-domain-event-audit
REDPANDA_BUSINESS_CONSUMER_GROUP_ID=agriflow-business-consumers
OUTBOX_RELAY_POLL_INTERVAL_SECONDS=2.0
OUTBOX_RELAY_BATCH_SIZE=100
ALERT_EVALUATION_ENABLED=true
SOIL_MOISTURE_LOW_THRESHOLD_PERCENT=20.0
ML_ENGINE_AUTO_RUN_ENABLED=false

# Feature Store (Phase 15)
FEATURE_STORE_REGISTRY_VERSION=cdd-v1.0.0
FEATURE_STORE_GDD_BASE_C=10.0

# CQRS dashboard read models (Phase 15)
READ_MODEL_PROJECTION_VERSION=v1
READ_MODEL_AUTO_REFRESH_ON_READ=true

# Digital Twin (Phase 15)
DIGITAL_TWIN_STATE_VERSION=twin-v1
DIGITAL_TWIN_AUTO_SYNC_ON_READ=true

# Event-driven intelligence projection (Phase 15 slice 4)
INTELLIGENCE_EVENT_PROJECTION_ENABLED=true

# Outbox ops / replay (optional in development; set in staging/production)
# EVENTS_OPS_API_KEY=change-me-events-ops-secret

# Temporal workflows (Phase 16)
TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agriflow-alerts
TEMPORAL_SOIL_MOISTURE_PERSISTENCE_MINUTES=15

# Farm Copilot / GaaS (Phase 16)
COPILOT_ENABLED=true
COPILOT_LLM_PROVIDER=none
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# MCP tool evaluation (Phase 16)
MCP_TOOLS_ENABLED=true

# Observability (Phase 16)
METRICS_ENABLED=true
